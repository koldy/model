{
	"name": "koldy-model",
	"version": "1.6.7",
	"description": "Worry-free JS object models",
	"main": "lib/index.js",
	"module": "esm/index.js",
	"typings": "./typings.d.ts",
	"sideEffects": false,
	"scripts": {
		"build": "npm run build:esm && npm run build:cjs",
		"build:esm": "babel --delete-dir-on-start --env-name esm -d esm/ src/",
		"build:cjs": "babel --delete-dir-on-start --env-name cjs -d lib/ src/",
		"prepublishOnly": "npm run test && npm run test:types && npm run build",
		"test": "jest",
		"test:types": "tsc --noEmit -p test/tsconfig.json && tsc --noEmit -p test/tsconfig.strict.json",
		"lint": "eslint ./src --ignore-pattern *.test.js"
	},
	"author": "Vlatko Koudela",
	"license": "MIT",
	"keywords": [
		"data handling",
		"data model",
		"data list"
	],
	"bugs": {
		"url": "https://github.com/koldy/model/issues"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/koldy/model.git"
	},
	"files": [
		"lib/*",
		"esm/*",
		"typings.d.ts"
	],
	"devDependencies": {
		"@babel/cli": "^8.0.6",
		"@babel/core": "^8.0.9",
		"@babel/eslint-parser": "^8.0.7",
		"@babel/polyfill": "^7.12.1",
		"@babel/preset-env": "^8.0.7",
		"core-js": "^3.51.0",
		"eslint": "^10.13.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.5.7",
		"jest": "^30.5.2",
		"jest-environment-jsdom": "^30.5.2",
		"prettier": "^3.9.10",
		"typescript": "^7.0.2"
	}
}
